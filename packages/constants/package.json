{
  "name": "@repo/constants",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./twitter-card": {
      "types": "./src/twitter-card.ts",
      "require": "./dist/twitter-card.js",
      "default": "./src/twitter-card.ts"
    },
    "./hreflang": {
      "types": "./src/hreflang.ts",
      "require": "./dist/hreflang.js",
      "default": "./src/hreflang.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({ type: 'commonjs' }) + '\\\\n')\"",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@types/node": "26.4.1",
    "typescript": "7.0.2",
    "eslint": "10.9.1"
  }
}
