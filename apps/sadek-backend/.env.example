PORT=4000
# Preferred for Vercel: use the SSL connection string from a hosted Postgres provider.
DATABASE_URL=
# Alternatively, supply the individual DB_* values and set DB_SSL=true when required.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true
TYPEORM_LOGGING=false
# Keep false in production; use migrations for schema changes.
TYPEORM_SYNC=false
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=

# Comma-separated allowed frontend origins for CORS.
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# Swagger UI (/api-docs) + OpenAPI spec (/openapi.json) for Apidog. Defaults to on outside production.
SWAGGER_ENABLED=true

# Public backend URL, listed as the "Production" server in the OpenAPI spec.
PRODUCTION_API_URL=

# Push the OpenAPI spec to Apidog on every dev start/reload (skipped when empty or in production).
# Token: Apidog > Account Settings > API Access Token. Project ID: Project Settings > Basic Settings.
APIDOG_ACCESS_TOKEN=
APIDOG_PROJECT_ID=
# Set true to also delete Apidog endpoints that no longer exist in the code.
APIDOG_DELETE_UNMATCHED=false
