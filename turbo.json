{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "sadek-backend#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["PORT", "FRONTEND_URL", "DATABASE_URL", "DB_*", "TYPEORM_*", "JWT_*"],
      "outputs": ["dist/**"]
    },
    "dashboard#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["BACKEND_URL", "NEXT_PUBLIC_BACKEND_URL"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dashboard#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["BACKEND_URL", "NEXT_PUBLIC_BACKEND_URL"]
    },
    "sadek-backend#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT", "FRONTEND_URL", "DATABASE_URL", "DB_*", "TYPEORM_*", "JWT_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
