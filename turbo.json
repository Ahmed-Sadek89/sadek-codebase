{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_BACKEND_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "sadek-backend#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "PORT",
        "FRONTEND_URL",
        "DATABASE_URL",
        "DB_*",
        "TYPEORM_*",
        "JWT_*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dashboard#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "BACKEND_URL",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_CLOUDFRONT_URL",
        "AUTH_SECRET",
        "AUTH_URL",
        "AUTH_TRUST_HOST",
        "AWS_REGION",
        "AWS_S3_BUCKET"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "web#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "BACKEND_URL",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_CLOUDFRONT_URL",
        "SITE_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**"
      ]
    },
    "dashboard#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BACKEND_URL",
        "NEXT_PUBLIC_BACKEND_URL",
        "NEXT_PUBLIC_CLOUDFRONT_URL",
        "AUTH_SECRET",
        "AUTH_URL",
        "AUTH_TRUST_HOST",
        "AWS_REGION",
        "AWS_S3_BUCKET",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY"
      ]
    },
    "sadek-backend#dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "FRONTEND_URL",
        "DATABASE_URL",
        "DB_*",
        "TYPEORM_*",
        "JWT_*"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
